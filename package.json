{
  "name": "bunest",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.5"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "bun check",
    "build": "bun run scripts/clean-dist.ts && bun run --workspaces --if-present build",
    "bench": "bun run benchmarks/run.ts",
    "lint": "bun check",
    "type:audit": "bun run scripts/type-tools/audit-any.ts",
    "type:audit:generics": "bun run scripts/type-tools/audit-generic-defaults.ts",
    "type:coverage": "bun run scripts/type-tools/check-type-coverage.ts",
    "type:gen": "bun run scripts/type-tools/generate-global-types.ts",
    "verify:release": "bun run scripts/verify-release.ts",
    "verify:staging-plan": "bun run scripts/verify-staging-registry.ts --plan",
    "publish:dry-run": "bun run scripts/publish-packages.ts --dry-run",
    "publish:packages": "bun run scripts/publish-packages.ts",
    "smoke:postgres": "bun run --cwd examples/production-rest-postgres smoke:postgres",
    "smoke:redis": "bun test tests/integration/redis-fault-injection.spec.ts",
    "ai:docs": "bun run scripts/ai-docs.ts",
    "conformance:gate": "bun run scripts/conformance-gate.ts",
    "conformance:report": "bun run scripts/conformance-report.ts",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "bun run --cwd apps/docs build",
    "docs:preview": "bun run --cwd apps/docs preview"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "typescript": "^7.0.2"
  }
}
