{
  "name": "@bunest/authorization",
  "version": "0.1.0",
  "description": "Policy-based authorization for Bunest: @Policy() classes, @Can() / @Can.Anyone() route enforcement, AuthorizationService, and audit events with 100% @nestjs/authorization parity",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bunest/bunest.git",
    "directory": "packages/authorization"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --format esm --external @bunest/common --external @bunest/core --external @bunest/websockets --external @bunest/microservices --external reflect-metadata",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@bunest/common": "workspace:*",
    "@bunest/core": "workspace:*"
  },
  "peerDependencies": {
    "@bunest/authentication": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@bunest/authentication": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bunest/testing": "workspace:*"
  }
}
