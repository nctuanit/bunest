{
  "name": "@bunest/security",
  "version": "0.1.0",
  "description": "Unified security, authentication (JWT/JWKS, sessions, TOTP MFA, magic links, OIDC/OAuth2, API keys, Bun.password), policy authorization (@Policy/@Can), CSRF (Bun.CSRF), rate limiting, and security headers for Bunest",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nctuanit/bunest.git",
    "directory": "packages/security"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./src/auth-next/index.ts",
      "bun": "./src/auth-next/index.ts",
      "import": "./dist/auth-next/index.js",
      "default": "./dist/auth-next/index.js"
    },
    "./authz": {
      "types": "./src/authz/index.ts",
      "bun": "./src/authz/index.ts",
      "import": "./dist/authz/index.js",
      "default": "./dist/authz/index.js"
    },
    "./jwt": {
      "types": "./src/jwt/index.ts",
      "bun": "./src/jwt/index.ts",
      "import": "./dist/jwt/index.js",
      "default": "./dist/jwt/index.js"
    },
    "./throttler": {
      "types": "./src/throttler/index.ts",
      "bun": "./src/throttler/index.ts",
      "import": "./dist/throttler/index.js",
      "default": "./dist/throttler/index.js"
    },
    "./testing": {
      "types": "./src/auth-next/testing/index.ts",
      "bun": "./src/auth-next/testing/index.ts",
      "import": "./dist/auth-next/testing/index.js",
      "default": "./dist/auth-next/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts ./src/auth-next/index.ts ./src/authz/index.ts ./src/jwt/index.ts ./src/throttler/index.ts ./src/auth-next/testing/index.ts --root ./src --outdir ./dist --target bun --format esm --splitting --external @bunest/core --external @bunest/core/common --external @bunest/core/http --external @bunest/core/config --external @bunest/core/client --external @bunest/core/ws --external @bunest/core/i18n",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@bunest/core": "workspace:*"
  },
  "devDependencies": {
    "@bunest/testing": "workspace:*"
  },
  "homepage": "https://nctuanit.github.io/bunest/",
  "bugs": {
    "url": "https://github.com/nctuanit/bunest/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
