{
  "name": "@bunest/mail",
  "version": "0.1.0",
  "description": "Transactional email for Bunest: typed mail classes, auto-escaped HTML templates, and SMTP, Resend, Postmark, SendGrid, and Amazon SES transports",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bunest/bunest.git",
    "directory": "packages/mail"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./smtp": {
      "types": "./src/smtp/index.ts",
      "bun": "./src/smtp/index.ts",
      "import": "./dist/smtp/index.js",
      "default": "./dist/smtp/index.js"
    },
    "./templates": {
      "types": "./src/templates/index.ts",
      "bun": "./src/templates/index.ts",
      "import": "./dist/templates/index.js",
      "default": "./dist/templates/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts ./src/smtp/index.ts ./src/templates/index.ts --root ./src --outdir ./dist --target bun --format esm --splitting --external @bunest/core --external @bunest/core/common --external @bunest/core/http --external @bunest/core/config --external @bunest/core/client --external @bunest/core/ws --external @bunest/core/i18n",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@bunest/core": "workspace:*"
  },
  "devDependencies": {
    "@bunest/testing": "workspace:*"
  }
}
