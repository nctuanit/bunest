{
  "name": "@bunest/swagger",
  "version": "0.1.0",
  "description": "OpenAPI 3.1 metadata decorators, DocumentBuilder, schema introspection, and Swagger UI explorer for Bunest",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bunest/bunest.git",
    "directory": "packages/swagger"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --format esm --external @bunest/core --external @bunest/validation --external @bunest/core/common --external @bunest/core/http --external @bunest/core/config --external @bunest/core/client --external @bunest/core/ws --external @bunest/core/i18n",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@bunest/core": "workspace:*"
  },
  "devDependencies": {
    "@bunest/testing": "workspace:*"
  }
}
