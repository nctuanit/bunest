{
  "name": "@bunest/observe",
  "version": "0.1.0",
  "description": "Observability and APM agent for Bunest: distributed tracing, runtime metrics, custom metrics, SLO objectives, redaction, and OTLP export",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bunest/bunest.git",
    "directory": "packages/observe"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "bin": {
    "observe": "./dist/cli/observe-cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts ./src/cli/observe-cli.ts --root ./src --outdir ./dist --target bun --format esm --external @bunest/common --external @bunest/core --external @bunest/http --external @bunest/observability --external reflect-metadata",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@bunest/common": "workspace:*",
    "@bunest/core": "workspace:*",
    "@bunest/http": "workspace:*",
    "@bunest/observability": "workspace:*"
  }
}
