{
  "name": "@bunest/validation",
  "version": "0.1.0",
  "description": "Zero-dependency Bun-native DTO validation & transformation engine (compile-once validator, transformer, ValidationPipe, ClassSerializerInterceptor, Standard Schema)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nctuanit/bunest.git",
    "directory": "packages/validation"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./validator": {
      "types": "./src/validator/index.ts",
      "bun": "./src/validator/index.ts",
      "import": "./dist/validator/index.js",
      "default": "./dist/validator/index.js"
    },
    "./transformer": {
      "types": "./src/transformer/index.ts",
      "bun": "./src/transformer/index.ts",
      "import": "./dist/transformer/index.js",
      "default": "./dist/transformer/index.js"
    },
    "./standard-schema": {
      "types": "./src/standard-schema/index.ts",
      "bun": "./src/standard-schema/index.ts",
      "import": "./dist/standard-schema/index.js",
      "default": "./dist/standard-schema/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts ./src/validator/index.ts ./src/transformer/index.ts ./src/standard-schema/index.ts --root ./src --outdir ./dist --target bun --format esm --splitting --external @bunest/core --external @bunest/core/common --external @bunest/core/http --external @bunest/core/config --external @bunest/core/client --external @bunest/core/ws --external @bunest/core/i18n",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@bunest/core": "workspace:*"
  },
  "devDependencies": {
    "@bunest/swagger": "workspace:*"
  },
  "homepage": "https://nctuanit.github.io/bunest/",
  "bugs": {
    "url": "https://github.com/nctuanit/bunest/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
