{
  "name": "@bunest/orm",
  "version": "0.1.0",
  "description": "Circular-safe, zero-dependency Bun-native ORM, declarative compiled-once repositories, migrations, and SQL store kit for Bunest",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nctuanit/bunest.git",
    "directory": "packages/orm"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./src/plugin.ts",
      "bun": "./src/plugin.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./store": {
      "types": "./src/store-kit/index.ts",
      "bun": "./src/store-kit/index.ts",
      "import": "./dist/store-kit/index.js",
      "default": "./dist/store-kit/index.js"
    },
    "./postgres": {
      "types": "./src/store-kit/postgres/index.ts",
      "bun": "./src/store-kit/postgres/index.ts",
      "import": "./dist/store-kit/postgres/index.js",
      "default": "./dist/store-kit/postgres/index.js"
    },
    "./mysql": {
      "types": "./src/store-kit/mysql/index.ts",
      "bun": "./src/store-kit/mysql/index.ts",
      "import": "./dist/store-kit/mysql/index.js",
      "default": "./dist/store-kit/mysql/index.js"
    },
    "./testing": {
      "types": "./src/store-kit/testing/index.ts",
      "bun": "./src/store-kit/testing/index.ts",
      "import": "./dist/store-kit/testing/index.js",
      "default": "./dist/store-kit/testing/index.js"
    },
    "./drizzle": {
      "types": "./src/integrations/drizzle.module.ts",
      "bun": "./src/integrations/drizzle.module.ts",
      "import": "./dist/integrations/drizzle.module.js",
      "default": "./dist/integrations/drizzle.module.js"
    },
    "./prisma": {
      "types": "./src/integrations/prisma.module.ts",
      "bun": "./src/integrations/prisma.module.ts",
      "import": "./dist/integrations/prisma.module.js",
      "default": "./dist/integrations/prisma.module.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts ./src/plugin.ts ./src/store-kit/index.ts ./src/store-kit/postgres/index.ts ./src/store-kit/mysql/index.ts ./src/store-kit/testing/index.ts ./src/integrations/drizzle.module.ts ./src/integrations/prisma.module.ts --root ./src --outdir ./dist --target bun --format esm --splitting --external @bunest/core --external bun --external bun:sqlite --external @bunest/core/common --external @bunest/core/http --external @bunest/core/config --external @bunest/core/client --external @bunest/core/ws --external @bunest/core/i18n",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@bunest/core": "workspace:*"
  },
  "devDependencies": {
    "@bunest/testing": "workspace:*"
  },
  "homepage": "https://nctuanit.github.io/bunest/",
  "bugs": {
    "url": "https://github.com/nctuanit/bunest/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
