{
  "name": "@bunest/graphql",
  "version": "0.1.0",
  "description": "Code-first & schema-first GraphQL module, Apollo Server, Federation v2 Subgraph & Gateway drivers, PubSub subscriptions, and GraphiQL explorer for Bunest",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nctuanit/bunest.git",
    "directory": "packages/graphql"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./apollo": {
      "types": "./src/apollo/index.ts",
      "bun": "./src/apollo/index.ts",
      "import": "./dist/apollo/index.js",
      "default": "./dist/apollo/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts ./src/apollo/index.ts --root ./src --outdir ./dist --target bun --format esm --splitting --external @bunest/core --external @bunest/core/common --external @bunest/core/http --external @bunest/core/config --external @bunest/core/client --external @bunest/core/ws --external @bunest/core/i18n",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@bunest/core": "workspace:*"
  },
  "devDependencies": {
    "@bunest/testing": "workspace:*"
  },
  "homepage": "https://nctuanit.github.io/bunest/",
  "bugs": {
    "url": "https://github.com/nctuanit/bunest/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
