{
  "name": "@bunest/graphql",
  "version": "0.1.0",
  "description": "Code-first and schema-first GraphQL module, PubSub subscriptions, depth limiting, and GraphiQL explorer for Bunest",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bunest/bunest.git",
    "directory": "packages/graphql"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --format esm --external @bunest/common --external @bunest/core --external @bunest/http --external graphql --external reflect-metadata",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@bunest/common": "workspace:*",
    "@bunest/core": "workspace:*",
    "@bunest/http": "workspace:*",
    "graphql": "^16.10.0"
  },
  "devDependencies": {
    "@bunest/testing": "workspace:*"
  }
}
