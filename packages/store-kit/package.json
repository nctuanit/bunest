{
  "name": "@bunest/store-kit",
  "version": "0.1.0",
  "description": "Foundational SQL store kit (PostgreSQL, MySQL/MariaDB, Bun.SQL, versioned migrations, CLI, and executor contract testing) for Bunest",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bunest/bunest.git",
    "directory": "packages/store-kit"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./src/postgres/index.ts",
      "bun": "./src/postgres/index.ts",
      "import": "./dist/postgres/index.js",
      "default": "./dist/postgres/index.js"
    },
    "./mysql": {
      "types": "./src/mysql/index.ts",
      "bun": "./src/mysql/index.ts",
      "import": "./dist/mysql/index.js",
      "default": "./dist/mysql/index.js"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "bun": "./src/testing/index.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts ./src/postgres/index.ts ./src/mysql/index.ts ./src/testing/index.ts --root ./src --outdir ./dist --target bun --format esm --splitting --external bun",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {}
}
