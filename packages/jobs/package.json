{
  "name": "@bunest/jobs",
  "version": "0.1.0",
  "description": "Background job queues (BullMQ parity + native Bun.RedisClient driver), cron/interval/timeout task scheduler, and multi-threaded Bun Workers pool for Bunest",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nctuanit/bunest.git",
    "directory": "packages/jobs"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./queues": {
      "types": "./src/queues/index.ts",
      "bun": "./src/queues/index.ts",
      "import": "./dist/queues/index.js",
      "default": "./dist/queues/index.js"
    },
    "./scheduler": {
      "types": "./src/scheduler/index.ts",
      "bun": "./src/scheduler/index.ts",
      "import": "./dist/scheduler/index.js",
      "default": "./dist/scheduler/index.js"
    },
    "./redis": {
      "types": "./src/redis/index.ts",
      "bun": "./src/redis/index.ts",
      "import": "./dist/redis/index.js",
      "default": "./dist/redis/index.js"
    },
    "./workers": {
      "types": "./src/workers/index.ts",
      "bun": "./src/workers/index.ts",
      "import": "./dist/workers/index.js",
      "default": "./dist/workers/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts ./src/queues/index.ts ./src/scheduler/index.ts ./src/redis/index.ts ./src/workers/index.ts --root ./src --outdir ./dist --target bun --format esm --splitting --external @bunest/core --external @bunest/core/common --external @bunest/core/http --external @bunest/core/config --external @bunest/core/client --external @bunest/core/ws --external @bunest/core/i18n",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@bunest/core": "workspace:*"
  },
  "devDependencies": {
    "@bunest/testing": "workspace:*"
  },
  "homepage": "https://nctuanit.github.io/bunest/",
  "bugs": {
    "url": "https://github.com/nctuanit/bunest/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
