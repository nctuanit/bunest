{
  "name": "@bunest/storage",
  "version": "0.1.0",
  "description": "File storage for Bunest: unified API for local disks, in-memory storage, and S3/R2/MinIO with native SigV4 fetch, streamed uploads, and signed URLs",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nctuanit/bunest.git",
    "directory": "packages/storage"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./s3": {
      "types": "./src/s3/index.ts",
      "bun": "./src/s3/index.ts",
      "import": "./dist/s3/index.js",
      "default": "./dist/s3/index.js"
    },
    "./local": {
      "types": "./src/local/index.ts",
      "bun": "./src/local/index.ts",
      "import": "./dist/local/index.js",
      "default": "./dist/local/index.js"
    },
    "./memory": {
      "types": "./src/memory/index.ts",
      "bun": "./src/memory/index.ts",
      "import": "./dist/memory/index.js",
      "default": "./dist/memory/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts ./src/s3/index.ts ./src/local/index.ts ./src/memory/index.ts --root ./src --outdir ./dist --target bun --format esm --splitting --external @bunest/core --external @bunest/core/common --external @bunest/core/http --external @bunest/core/config --external @bunest/core/client --external @bunest/core/ws --external @bunest/core/i18n",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@bunest/core": "workspace:*"
  },
  "homepage": "https://nctuanit.github.io/bunest/",
  "bugs": {
    "url": "https://github.com/nctuanit/bunest/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
