{
  "name": "@bunest/ai",
  "version": "0.1.0",
  "description": "Language models for Bunest: model calls with timeouts, retries and fallbacks, structured output, tools and agents, and streaming.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bunest/bunest.git",
    "directory": "packages/ai"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "bun": "./src/testing/index.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./workflows": {
      "types": "./src/workflows/index.ts",
      "bun": "./src/workflows/index.ts",
      "import": "./dist/workflows/index.js",
      "default": "./dist/workflows/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts ./src/testing/index.ts ./src/workflows/index.ts --root ./src --outdir ./dist --target bun --format esm --splitting --external @bunest/common --external @bunest/core --external @bunest/resilience --external @bunest/workflows --external @bunest/testing --external reflect-metadata",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@bunest/common": "workspace:*",
    "@bunest/core": "workspace:*",
    "@bunest/resilience": "workspace:*",
    "@bunest/workflows": "workspace:*",
    "@bunest/testing": "workspace:*"
  }
}
