{
  "name": "@bunest/observability",
  "version": "0.1.0",
  "description": "Distributed W3C tracing, OpenTelemetry OTLP export, Prometheus metrics, Terminus-style health checks, correlated logging, and Devtools graph introspection for Bunest",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bunest/bunest.git",
    "directory": "packages/observability"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tracing": {
      "types": "./src/tracing/index.ts",
      "bun": "./src/tracing/index.ts",
      "import": "./dist/tracing/index.js",
      "default": "./dist/tracing/index.js"
    },
    "./metrics": {
      "types": "./src/metrics/index.ts",
      "bun": "./src/metrics/index.ts",
      "import": "./dist/metrics/index.js",
      "default": "./dist/metrics/index.js"
    },
    "./health": {
      "types": "./src/health/index.ts",
      "bun": "./src/health/index.ts",
      "import": "./dist/health/index.js",
      "default": "./dist/health/index.js"
    },
    "./devtools": {
      "types": "./src/devtools/index.ts",
      "bun": "./src/devtools/index.ts",
      "import": "./dist/devtools/index.js",
      "default": "./dist/devtools/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts ./src/tracing/index.ts ./src/metrics/index.ts ./src/health/index.ts ./src/devtools/index.ts --root ./src --outdir ./dist --target bun --format esm --splitting --external @bunest/core --external @bunest/core/common --external @bunest/core/http",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@bunest/core": "workspace:*"
  }
}
