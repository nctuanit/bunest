{
  "name": "@bunest/outbox",
  "version": "0.1.0",
  "description": "Transactional outbox, consumer inbox deduplication, leased relay, dead letters, and PostgreSQL/MySQL stores for Bunest",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bunest/bunest.git",
    "directory": "packages/outbox"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "bin": {
    "nest-outbox": "./dist/sql/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "bun": "./src/testing/index.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./postgres": {
      "types": "./src/postgres/index.ts",
      "bun": "./src/postgres/index.ts",
      "import": "./dist/postgres/index.js",
      "default": "./dist/postgres/index.js"
    },
    "./mysql": {
      "types": "./src/mysql/index.ts",
      "bun": "./src/mysql/index.ts",
      "import": "./dist/mysql/index.js",
      "default": "./dist/mysql/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts ./src/testing/index.ts ./src/postgres/index.ts ./src/mysql/index.ts ./src/sql/cli.ts --root ./src --outdir ./dist --target bun --format esm --splitting --external @bunest/common --external @bunest/core --external @bunest/store-kit --external @bunest/store-kit/postgres --external @bunest/store-kit/mysql --external reflect-metadata",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@bunest/common": "workspace:*",
    "@bunest/core": "workspace:*",
    "@bunest/store-kit": "workspace:*"
  },
  "devDependencies": {
    "@bunest/testing": "workspace:*"
  }
}
