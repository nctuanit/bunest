{
  "name": "@bunest/resilience",
  "version": "0.1.0",
  "description": "Resilience policies (retry, timeout, circuit breaker, bulkhead, fallback), leased distributed locks (@WithLock, leader election), and @Idempotent() deduplication for Bunest",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bunest/bunest.git",
    "directory": "packages/resilience"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./locks": {
      "types": "./src/locks/index.ts",
      "bun": "./src/locks/index.ts",
      "import": "./dist/locks/index.js",
      "default": "./dist/locks/index.js"
    },
    "./locks/testing": {
      "types": "./src/locks/testing/index.ts",
      "bun": "./src/locks/testing/index.ts",
      "import": "./dist/locks/testing/index.js",
      "default": "./dist/locks/testing/index.js"
    },
    "./idempotency": {
      "types": "./src/idempotency/index.ts",
      "bun": "./src/idempotency/index.ts",
      "import": "./dist/idempotency/index.js",
      "default": "./dist/idempotency/index.js"
    },
    "./idempotency/testing": {
      "types": "./src/idempotency/testing/index.ts",
      "bun": "./src/idempotency/testing/index.ts",
      "import": "./dist/idempotency/testing/index.js",
      "default": "./dist/idempotency/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts ./src/locks/index.ts ./src/locks/testing/index.ts ./src/idempotency/index.ts ./src/idempotency/testing/index.ts --root ./src --outdir ./dist --target bun --format esm --splitting --external @bunest/core --external @bunest/core/common --external @bunest/core/http --external @bunest/core/config --external @bunest/core/client --external @bunest/core/ws --external @bunest/core/i18n",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@bunest/core": "workspace:*"
  },
  "devDependencies": {
    "@bunest/testing": "workspace:*"
  }
}
