{
  "name": "@bunest/workflows",
  "version": "0.1.0",
  "description": "Durable workflows for Bunest: long-running processes written as plain async code that survive restarts, with replay, signals, timers, sagas, schedules, CQRS, and SQL stores.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nctuanit/bunest.git",
    "directory": "packages/workflows"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "bin": {
    "nest-workflows": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "bun": "./src/testing/index.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./cqrs": {
      "types": "./src/cqrs/index.ts",
      "bun": "./src/cqrs/index.ts",
      "import": "./dist/cqrs/index.js",
      "default": "./dist/cqrs/index.js"
    },
    "./postgres": {
      "types": "./src/postgres/index.ts",
      "bun": "./src/postgres/index.ts",
      "import": "./dist/postgres/index.js",
      "default": "./dist/postgres/index.js"
    },
    "./mysql": {
      "types": "./src/mysql/index.ts",
      "bun": "./src/mysql/index.ts",
      "import": "./dist/mysql/index.js",
      "default": "./dist/mysql/index.js"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "bun": "./src/core/index.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts ./src/testing/index.ts ./src/cqrs/index.ts ./src/postgres/index.ts ./src/mysql/index.ts ./src/core/index.ts ./src/cli.ts --root ./src --outdir ./dist --target bun --format esm --splitting --external @bunest/core --external @bunest/messaging --external @bunest/orm --external @bunest/orm/store --external @bunest/orm/postgres --external @bunest/orm/mysql --external @bunest/orm/testing --external @bunest/core/common --external @bunest/core/http --external @bunest/core/config --external @bunest/core/client --external @bunest/core/ws --external @bunest/core/i18n --external @bunest/messaging/events --external @bunest/messaging/cqrs --external @bunest/messaging/outbox --external @bunest/messaging/webhooks",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@bunest/core": "workspace:*",
    "@bunest/messaging": "workspace:*",
    "@bunest/orm": "workspace:*"
  },
  "devDependencies": {
    "@bunest/testing": "workspace:*"
  },
  "homepage": "https://nctuanit.github.io/bunest/",
  "bugs": {
    "url": "https://github.com/nctuanit/bunest/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
