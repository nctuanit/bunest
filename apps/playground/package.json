{
  "name": "@bunest/playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive all-in-one Bunest showcase with CRUD, OpenAPI Swagger, Health, Prometheus Metrics, and Devtools Graph",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch src/main.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@bunest/core": "workspace:*",
    "@bunest/observability": "workspace:*",
    "@bunest/orm": "workspace:*",
    "@bunest/swagger": "workspace:*",
    "@bunest/validation": "workspace:*"
  },
  "devDependencies": {
    "@bunest/testing": "workspace:*"
  }
}
