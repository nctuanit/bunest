{
  "name": "vscode-bunest",
  "displayName": "Bunest — Framework IntelliSense, Declarative Repositories & Class Macros",
  "description": "First-class VS Code DX for Bunest: Live Global Typegen, Declarative Repository Derived Query Autocomplete & SQL Preview (@SoftDelete/@TenantScoped/@Projection/Page<T>/Custom Operators), Custom Class Macros & Presets (Hover / Diagnostics), bunest.config.ts Hot-Reload, Static & Architecture Diagnostics with TextEditor AST Quick Fixes, Inline HTTP Runner, and Interactive DI Module Graph.",
  "version": "0.1.0",
  "publisher": "bunest",
  "icon": "media/bunest-logo.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nctuanit/bunest.git",
    "directory": "apps/vscode-bunest"
  },
  "homepage": "https://nctuanit.github.io/bunest/",
  "bugs": {
    "url": "https://github.com/nctuanit/bunest/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "bunest",
    "bun",
    "typescript",
    "nestjs",
    "repository",
    "lombok",
    "di",
    "typegen"
  ],
  "activationEvents": [
    "workspaceContains:bunest.config.ts",
    "workspaceContains:bunest.json",
    "workspaceContains:package.json",
    "onLanguage:typescript"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bunest-explorer",
          "title": "Bunest",
          "icon": "media/bunest-icon.svg"
        }
      ]
    },
    "views": {
      "bunest-explorer": [
        {
          "id": "bunest.routesView",
          "name": "Routes"
        },
        {
          "id": "bunest.dataModelsView",
          "name": "Data & Repositories"
        },
        {
          "id": "bunest.migrationsView",
          "name": "Migrations & Schema"
        },
        {
          "id": "bunest.eventsRpcView",
          "name": "Events & RPC"
        },
        {
          "id": "bunest.modulesView",
          "name": "Modules & DI"
        }
      ]
    },
    "commands": [
      {
        "command": "bunest.regenerateTypes",
        "title": "Bunest: Run Typegen (CLI)",
        "icon": "$(sync)"
      },
      {
        "command": "bunest.runCheck",
        "title": "Bunest: Run Static Check (CLI)",
        "icon": "$(checklist)"
      },
      {
        "command": "bunest.refreshWorkspace",
        "title": "Bunest: Refresh Read-Only AST Index",
        "icon": "$(refresh)"
      },
      {
        "command": "bunest.openDiGraph",
        "title": "Bunest: Open Interactive DI Module Graph",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "bunest.sendRequest",
        "title": "Bunest: Send HTTP Request",
        "icon": "$(play)"
      },
      {
        "command": "bunest.copyRouteUrl",
        "title": "Bunest: Copy Route URL",
        "icon": "$(copy)"
      },
      {
        "command": "bunest.generateSchematic",
        "title": "Bunest: Generate Component (Module / Controller / Service / Guard...)"
      },
      {
        "command": "bunest.generateRepository",
        "title": "Bunest: Generate Declarative Repository from @Entity()"
      },
      {
        "command": "bunest.previewRepositorySql",
        "title": "Bunest: Preview Compiled SQL"
      },
      {
        "command": "bunest.executeRawQuery",
        "title": "Bunest: Execute Raw SQL Query",
        "icon": "$(database)"
      },
      {
        "command": "bunest.configureDatabaseConnection",
        "title": "Bunest: Configure Database Connection (SQL Runner)",
        "icon": "$(plug)"
      },
      {
        "command": "bunest.syncDiConstructor",
        "title": "Bunest: Auto-Sync DI Constructor"
      },
      {
        "command": "bunest.runBunTest",
        "title": "Bunest: Run bun test",
        "icon": "$(beaker)"
      },
      {
        "command": "bunest.revealLocation",
        "title": "Bunest: Reveal Source Location"
      },
      {
        "command": "bunest.openHttpStudio",
        "title": "Bunest: Open HTTP Request Studio",
        "icon": "$(globe)"
      },
      {
        "command": "bunest.openLiveInspector",
        "title": "Bunest: Open Live App Inspector",
        "icon": "$(pulse)"
      },
      {
        "command": "bunest.openQuickMenu",
        "title": "Bunest: Open Quick Actions Menu",
        "icon": "$(zap)"
      },
      {
        "command": "bunest.filterRoutes",
        "title": "Bunest: Filter Routes",
        "icon": "$(filter)"
      },
      {
        "command": "bunest.toggleRoutesGroupBy",
        "title": "Bunest: Toggle Routes Group By (Controller / Method)",
        "icon": "$(list-tree)"
      },
      {
        "command": "bunest.refreshMigrations",
        "title": "Bunest: Refresh Migrations & Schema Drift",
        "icon": "$(refresh)"
      },
      {
        "command": "bunest.runMigrations",
        "title": "Bunest: Run Migrations (bun run migrate)",
        "icon": "$(play)"
      }
    ],
    "viewsWelcome": [
      {
        "view": "bunest.routesView",
        "contents": "No Bunest HTTP routes found in this workspace.\n[Generate Controller](command:bunest.generateSchematic)\n[Open HTTP Studio](command:bunest.openHttpStudio)"
      },
      {
        "view": "bunest.dataModelsView",
        "contents": "No `@Entity()` or `@Repository()` classes found yet.\n[Configure Database](command:bunest.configureDatabaseConnection)\n[Refresh Index](command:bunest.refreshWorkspace)"
      },
      {
        "view": "bunest.migrationsView",
        "contents": "No migration files detected yet.\n[Run Migrations](command:bunest.runMigrations)\n[Refresh Migrations](command:bunest.refreshMigrations)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "bunest.generateSchematic",
          "when": "explorerResourceIsFolder",
          "group": "bunest@1"
        }
      ],
      "view/title": [
        {
          "command": "bunest.refreshWorkspace",
          "when": "view == bunest.routesView || view == bunest.dataModelsView || view == bunest.eventsRpcView || view == bunest.modulesView",
          "group": "navigation@1"
        },
        {
          "command": "bunest.openDiGraph",
          "when": "view == bunest.modulesView",
          "group": "navigation@2"
        },
        {
          "command": "bunest.regenerateTypes",
          "when": "view == bunest.routesView",
          "group": "navigation@2"
        },
        {
          "command": "bunest.filterRoutes",
          "when": "view == bunest.routesView",
          "group": "navigation@3"
        },
        {
          "command": "bunest.toggleRoutesGroupBy",
          "when": "view == bunest.routesView",
          "group": "navigation@4"
        },
        {
          "command": "bunest.openHttpStudio",
          "when": "view == bunest.routesView",
          "group": "navigation@5"
        },
        {
          "command": "bunest.runMigrations",
          "when": "view == bunest.migrationsView",
          "group": "navigation@1"
        },
        {
          "command": "bunest.refreshMigrations",
          "when": "view == bunest.migrationsView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "bunest.sendRequest",
          "when": "view == bunest.routesView && viewItem == bunestRoute",
          "group": "inline@1"
        },
        {
          "command": "bunest.copyRouteUrl",
          "when": "view == bunest.routesView && viewItem == bunestRoute",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "Bunest",
      "properties": {
        "bunest.typegen.live": {
          "type": "boolean",
          "default": true,
          "description": "Automatically regenerate .bunest/types/bunest.d.ts live from unsaved editor buffers as you type (no file save required)."
        },
        "bunest.typegen.debounceMs": {
          "type": "number",
          "default": 120,
          "description": "Debounce delay in milliseconds for live in-memory AST re-indexing and zero-save typegen while typing."
        },
        "bunest.index.debounceMs": {
          "type": "number",
          "default": 120,
          "description": "Fallback debounce delay in milliseconds for in-memory AST re-indexing."
        },
        "bunest.http.baseUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "Default base URL for the inline Bunest HTTP Request Runner."
        },
        "bunest.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Bunest static & architecture diagnostics (BUNEST001..007, BUNEST_REPO001..007, BUNEST_MACRO001..005, BUNEST_DEC001..005, BUNEST_ARCH001..002, and custom rules from bunest.config.ts)."
        },
        "bunest.codelens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Bunest CodeLens actions for HTTP routes, repositories, and tests."
        },
        "bunest.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show subtle inline SQL preview hints next to declarative repository derived query methods."
        },
        "bunest.http.environments": {
          "type": "array",
          "default": [],
          "description": "Named environment profiles (e.g. Staging, Production) for the Bunest HTTP Request Studio.",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "baseUrl": { "type": "string" }
            }
          }
        },
        "bunest.hover.revealSecrets": {
          "type": "boolean",
          "default": false,
          "description": "When false (recommended), redacts sensitive .env keys (SECRET, PASSWORD, TOKEN, KEY, AUTH, CREDENTIAL, DSN) in hover previews."
        },
        "bunest.sql.databaseUrl": {
          "type": "string",
          "default": "",
          "description": "Default database connection URL for the inline Bunest SQL Runner: sqlite://./dev.db, postgres://..., cockroachdb://..., mysql://..., mariadb://..., libsql://..., or d1://accountId/databaseId. When empty, auto-discovers from .env, bunest.sql.connections, or workspace SQLite files."
        },
        "bunest.sql.connections": {
          "type": "array",
          "default": [],
          "description": "Named multi-database connection profiles for the Bunest SQL Runner (SQLite, PostgreSQL, CockroachDB, MySQL, MariaDB, LibSQL/Turso, Cloudflare D1).",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "description": "Display name for the connection profile." },
              "dialect": {
                "type": "string",
                "enum": ["sqlite", "postgres", "cockroachdb", "mysql", "mariadb", "libsql", "d1"],
                "description": "Optional explicit SQL dialect (auto-detected from url when omitted)."
              },
              "url": { "type": "string", "description": "Connection URL or SQLite file path." },
              "authToken": { "type": "string", "description": "Bearer token for LibSQL / Turso." },
              "accountId": { "type": "string", "description": "Cloudflare Account ID (for D1)." },
              "databaseId": { "type": "string", "description": "Cloudflare D1 Database ID." },
              "apiToken": { "type": "string", "description": "Cloudflare API Token (for D1)." }
            }
          }
        },
        "bunest.sql.maxRows": {
          "type": "number",
          "default": 500,
          "description": "Maximum number of rows rendered in the Bunest SQL Runner result table."
        },
        "bunest.sql.timeoutMs": {
          "type": "number",
          "default": 15000,
          "description": "Execution timeout in milliseconds for inline raw SQL queries."
        },
        "bunest.sql.confirmWrites": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before executing write/DDL SQL statements (INSERT, UPDATE, DELETE, DROP, ALTER...) in the SQL Runner."
        },
        "bunest.sql.bunPath": {
          "type": "string",
          "default": "bun",
          "description": "Path to the Bun executable used by the inline SQL Runner to execute SQLite/PostgreSQL/MySQL queries via native Bun.SQL."
        }
      }
    }
  },
  "scripts": {
    "build": "bun run ./build.ts",
    "watch": "bun run ./build.ts --watch",
    "package": "bun run ./build.ts && bunx @vscode/vsce package --no-dependencies",
    "typecheck": "bun check",
    "test": "bun test"
  },
  "dependencies": {
    "@bunest/cli": "workspace:*",
    "@bunest/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "typescript": "^7.0.2"
  }
}
