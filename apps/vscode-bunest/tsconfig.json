{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"],
    "types": ["vscode", "bun"],
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@bunest/cli": ["./../../packages/cli/src/index.ts"],
      "@bunest/cli/analyzer": ["./../../packages/cli/src/analyzer/index.ts"],
      "@bunest/core": ["./../../packages/core/src/index.ts"]
    }
  },
  "include": ["build.ts", "src/**/*.ts", "test/**/*.ts"]
}
