{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Bunest Extension (Playground)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/../playground"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "bunest: build extension"
    },
    {
      "name": "Run Bunest Extension (auth-jwt-sqlite)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/../../examples/auth-jwt-sqlite"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "bunest: build extension"
    }
  ]
}
