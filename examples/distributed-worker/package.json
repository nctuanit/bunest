{
  "name": "@bunest/example-distributed-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.5"
  },
  "description": "Distributed order processing with CQRS, SQLite, Queues with retries, Events, and end-to-end W3C tracing, metrics, and health checks",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch src/main.ts",
    "test": "bun test",
    "typegen": "bun run ../../packages/cli/src/cli.ts typegen",
    "typecheck": "bun run typegen && bun check"
  },
  "dependencies": {
    "@bunest/core": "workspace:*",
    "@bunest/messaging": "workspace:*",
    "@bunest/observability": "workspace:*",
    "@bunest/orm": "workspace:*",
    "@bunest/jobs": "workspace:*"
  },
  "devDependencies": {
    "@bunest/cli": "workspace:*",
    "@bunest/testing": "workspace:*"
  }
}
