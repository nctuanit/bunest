{
  "name": "@bunest/example-functional-minimal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.5"
  },
  "description": "Zero-boilerplate Hono/Elysia-style Bunest microservice: defineRoutes() + BunestFactory.createRoutes() + s.* Standard Schema + DI + Swagger",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch src/main.ts",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@bunest/core": "workspace:*",
    "@bunest/swagger": "workspace:*",
    "@bunest/validation": "workspace:*"
  },
  "devDependencies": {
    "@bunest/testing": "workspace:*"
  }
}
