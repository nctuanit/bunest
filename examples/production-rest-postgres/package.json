{
  "name": "@bunest/example-production-rest-postgres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.5"
  },
  "description": "Production preview reference REST API with PostgreSQL, migrations, health checks, metrics, and graceful shutdown",
  "scripts": {
    "build": "bun build src/main.ts --outdir dist --target bun && bun build src/migrate.ts --outdir dist --target bun",
    "start": "bun run dist/main.js",
    "start:src": "bun run src/main.ts",
    "migrate": "bun run src/migrate.ts",
    "migrate:dist": "bun run dist/migrate.js",
    "smoke:postgres": "bun run scripts/smoke-postgres.ts",
    "load": "bun run scripts/load-test.ts",
    "test": "bun test",
    "typegen": "bun run ../../packages/cli/src/cli.ts typegen",
    "typecheck": "bun run typegen && bun check"
  },
  "dependencies": {
    "@bunest/core": "workspace:*",
    "@bunest/orm": "workspace:*",
    "@bunest/validation": "workspace:*"
  },
  "devDependencies": {
    "@bunest/cli": "workspace:*",
    "@bunest/testing": "workspace:*"
  }
}
